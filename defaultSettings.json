	// Interactive Rebase Editor
	// Specifies the layout density of the _Interactive Rebase Editor_
	//  - compact: Compact layout with minimal spacing
	//  - comfortable: Comfortable layout with more space between rows
	"gitlens.rebaseEditor.density": "comfortable",

	// Specifies which editor group the _Interactive Rebase Editor_ opens in when it is automatically reopened on a paused rebase
	//  - auto: Opens the editor beside the commit message editor when a multi-pane layout already exists; otherwise opens in the active editor group
	//  - beside: Always opens the editor beside the active editor, creating a new editor group if needed
	"gitlens.rebaseEditor.openBehavior": "auto",

	// Specifies whether to automatically open the _Interactive Rebase Editor_ when a paused rebase is detected
	//  - false: Never automatically open the editor
	//  - interactive: Only automatically open the editor when an interactive rebase is detected
	//  - true: Automatically open the editor when any paused rebase is detected
	"gitlens.rebaseEditor.openOnPausedRebase": true,

	// Specifies how Git commits are displayed in the _Interactive Rebase Editor_
	//  - asc: Shows oldest commit first
	//  - desc: Shows newest commit first
	"gitlens.rebaseEditor.ordering": "desc",

	// Specifies when to automatically reveal commits in the `gitlens.rebaseEditor.revealLocation` location
	//  - onDoubleClick: Automatically reveals commits when double-clicking on a row
	//  - onSelection: Automatically reveals commits when selection changes or when double-clicking on a row
	"gitlens.rebaseEditor.revealBehavior": "onDoubleClick",

	// Specifies where to reveal commits and references
	//  - graph: Reveals commits in the _Commit Graph_
	//  - inspect: Reveals commits in the _Inspect_ view
	"gitlens.rebaseEditor.revealLocation": "graph",

