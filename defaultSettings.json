	// Mercurial
	// Indica pastas ou [padrões glob](https://code.visualstudio.com/docs/editor/glob-patterns) para procurar projetos Mercurial
	"projectManager.hg.baseFolders": [],

	// Indica pastas ou [padrões glob](https://code.visualstudio.com/docs/editor/glob-patterns) a serem ignorados ao procurar projetos
	"projectManager.hg.ignoredFolders": [
		"node_modules",
		"out",
		"typings",
		"test",
		".haxelib"
	],

	// Indica a profundidade máxima de pastas recursivas na procura por projetos. Qualquer valor abaixo de 1 significa sem limites
	"projectManager.hg.maxDepthRecursion": 4,

