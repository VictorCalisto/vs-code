	// Mintlify Doc Writer
	// Set the name of the author. Replaces `{{author}}`
	"docwriter.custom.author": "",

	// Format using [mustache template syntax](https://mustache.github.io/mustache.5.html)
	// 
	// ‎
	// 
	// `{{summary}}`: summary of the function
	// 
	// `{{#params}}`
	// 
	// `{{name}}`: name of the parameter - `{{type}}`: type of the parameter - `{{defaultValue}}`: default parameter value - `{{paramExplained}}`: summary of the parameter
	// 
	// `{{/params}}`
	// 
	// `{{returnExplained}}`: description of the return value
	// 
	// `{{author}}`: name of the author
	// 
	// `{{date}}`: the current date (in dd/mm/yyyy)
	"docwriter.custom.template": "{{summary}}\n{{#params}}\n@param {{name}} ({{type}}) - {{paramExplained}}\n{{/params}}\n{{#returnExplained}}\n@returns {{.}}\n{{/returnExplained}}\n\nGenerated on {{date}}",

	// The hotkey used for generating documentation (only for Macs)
	//  - ⌘ + .: Command + .
	//  - ⌥ + .: Option + .
	"docwriter.hotkey.mac": "⌘ + .",

	// The hotkey used for generating documentation (only for Windows/Linux)
	//  - Ctrl + .: Control + .
	//  - Alt + .: Alt + .
	"docwriter.hotkey.windows": "Ctrl + .",

	// Toggle to specify the language of the generated documentation
	//  - English: English
	//  - Chinese: 中文
	//  - Dutch: française
	//  - French: 한국어
	//  - Japanese: Русский
	//  - Korean: Española
	//  - Russian: Türkçe
	"docwriter.language": "English",

	// Toggle to include classes in documentation progress tracking
	"docwriter.progress.trackClasses": false,

	// Toggle to include functions in documentation progress tracking
	"docwriter.progress.trackFunctions": true,

	// Toggle to include methods in documentation progress tracking
	"docwriter.progress.trackMethods": true,

	// Toggle to include type definitions in documentation progress tracking
	"docwriter.progress.trackTypes": false,

	// The format style of documents generated
	//  - Auto-detect: Automatically configured based on the language
	//  - JSDoc: The conventional document format for JavaScript
	//  - reST: The conventional reStructured text documentation format for Python
	//  - NumPy: The conventional NumPy documentation format for Python
	//  - DocBlock: A documentation format for PHP
	//  - Doxygen: The de facto standard tool for generating documentation for C++ and C
	//  - Javadoc: The conventional documentation format for Java
	//  - GoDoc: The conventional documentation format for Go
	//  - RustDoc: The unofficial documentation format for Rust
	//  - XML: The conventional documentation format for C# in XML
	//  - Google: Format from the Google Python Style Guide
	//  - Custom: Custom template based on your own style and preferences
	"docwriter.style": "Auto-detect",

	// Container Tools
	// Command templates for container attach commands.
	"containers.commands.attach": "${containerCommand} exec -it ${containerId} ${shellCommand}",

	// Command template(s) for container build commands.
	"containers.commands.build": "${containerCommand} build --pull --rm -f \"${dockerfile}\" -t ${tag} \"${context}\"",

	// Command templates for compose down commands.
	"containers.commands.composeDown": [
		{
			"label": "Compose Down",
			"template": "${composeCommand} ${configurationFile} down"
		}
	],

	// Command templates for compose down (subset) commands.
	"containers.commands.composeDownSubset": [
		{
			"label": "Compose Down",
			"template": "${composeCommand} ${profileList} ${configurationFile} down ${serviceList}"
		}
	],

	// Command templates for compose up commands.
	"containers.commands.composeUp": [
		{
			"label": "Compose Up",
			"template": "${composeCommand} ${configurationFile} up ${detached} ${build}"
		}
	],

	// Command templates for compose up (subset) commands.
	"containers.commands.composeUpSubset": [
		{
			"label": "Compose Up",
			"template": "${composeCommand} ${profileList} ${configurationFile} up ${detached} ${build} ${serviceList}"
		}
	],

	// Command templates for container logs commands.
	"containers.commands.logs": "${containerCommand} logs --tail 1000 -f ${containerId}",

	// Command templates for container run commands.
	"containers.commands.run": "${containerCommand} run --rm -d ${exposedPorts} ${tag}",

	// Command templates for container run (interactive) commands.
	"containers.commands.runInteractive": "${containerCommand} run --rm -it ${exposedPorts} ${tag}",

	// Set to true to include --build option when compose command is invoked
	"containers.composeBuild": true,

	// Command to use for compose actions (e.g. `docker-compose`, `docker compose`, etc. command). If the executable path contains whitespace, it needs to be quoted appropriately. If unset, the extension will attempt to auto-detect the command to use.
	"containers.composeCommand": "",

	// Set to true to include --d (detached) option when compose command is invoked
	"containers.composeDetached": true,

