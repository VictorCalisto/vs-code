	//  - off: Desligar o contador.
	"git.countBadge": "all",

	// Controla se o Git contribui com cores e selos para o Explorador e para a exibição Editores Abertos.
	"git.decorations.enabled": true,

	// O nome do branch padrão (exemplo: principal, tronco, desenvolvimento) ao inicializar um novo repositório Git. Quando definido como vazio, o nome do branch padrão configurado no Git será usado. **Observação:** Requer o Git versão `2.28.0` ou posterior.
	"git.defaultBranchName": "main",

	// O local padrão para clonar um repositório Git.
	"git.defaultCloneDirectory": null,

	// Controla se os submódulos do Git devem ser detectados automaticamente.
	"git.detectSubmodules": true,

	// Controla o limite de submódulos do Git detectados.
	"git.detectSubmodulesLimit": 10,

	// Controla se as árvores de trabalho do Git devem ser detectadas automaticamente.
	"git.detectWorktrees": true,

	// Controla o limite de árvores de trabalho do Git detectado.
	"git.detectWorktreesLimit": 50,

	// Controla se a verificação de diagnósticos não resolvidos deve ser feita antes de confirmar.
	"git.diagnosticsCommitHook.enabled": false,

	// Controla a lista de fontes (**Item**) e a gravidade mínima (**Valor**) a serem consideradas antes da confirmação. **Observação:** Para ignorar diagnósticos de uma fonte específica, adicione a fonte à lista e defina a gravidade mínima como `none`.
	"git.diagnosticsCommitHook.sources": {
