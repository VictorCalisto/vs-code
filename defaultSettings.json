	// Indica pastas ou [padrões glob](https://code.visualstudio.com/docs/editor/glob-patterns) para procurar projetos SVN
	"projectManager.svn.baseFolders": [],

	// Indica pastas ou [padrões glob](https://code.visualstudio.com/docs/editor/glob-patterns) a serem ignorados ao procurar projetos
	"projectManager.svn.ignoredFolders": [
		"node_modules",
		"out",
		"typings",
