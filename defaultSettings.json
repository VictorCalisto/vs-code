	// Controls the scope of diagnostic analysis. When set to 'openFilesOnly', diagnostics are only provided for files currently open in the editor. When set to 'workspace', diagnostics are computed and published for all files in the workspace. If `python.pyrefly.diagnosticMode` is set, it takes precedence.
	"python.analysis.diagnosticMode": "openFilesOnly",

	// Format used when Pyrefly auto-inserts an import.
	"python.analysis.importFormat": "absolute",

	// Controls which inlay hints Pyrefly displays.
