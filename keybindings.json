// =====================================================================
//  keybindings.json  -  Antigravity IDE
//  Autor: Victor Calisto
//  Stack: Ruby on Rails · Python · Java · JS/TS · ERB/Tailwind · Docker · SQL
//  Foco: 100% produtividade. Atalhos agrupados por contexto.
//  Versão CORRIGIDA: comandos validados contra os IDs reais do editor.
//
//  CONVENÇÃO DE "when":
//    editorTextFocus   -> cursor dentro do editor de código
//    terminalFocus     -> foco no terminal integrado
//    textInputFocus    -> qualquer campo de texto
//    !editorReadonly   -> evita disparar edições em arquivos read-only
// =====================================================================
[

  // ===================================================================
  //  1. EDIÇÃO BÁSICA
  // ===================================================================
  {
    // Copiar (só em texto, NÃO no terminal, pra não brigar com o SIGINT)
    "key": "ctrl+c",
    "command": "editor.action.clipboardCopyAction",
    "when": "textInputFocus && !terminalFocus"
  },
  {
    "key": "ctrl+v",
    "command": "editor.action.clipboardPasteAction",
    "when": "textInputFocus && !terminalFocus"
  },
  {
    "key": "ctrl+x",
    "command": "editor.action.clipboardCutAction",
    "when": "textInputFocus && !terminalFocus"
  },
  {
    "key": "ctrl+z",
    "command": "undo",
    "when": "editorTextFocus && !editorReadonly"
  },
  {
    "key": "ctrl+y",
    "command": "redo",
    "when": "editorTextFocus && !editorReadonly"
  },
  {
    "key": "ctrl+shift+z",
    "command": "redo",
    "when": "editorTextFocus && !editorReadonly"
  },
  {
    "key": "ctrl+a",
    "command": "editor.action.selectAll",
    "when": "editorTextFocus"
  },
  {
    "key": "ctrl+s",
    "command": "workbench.action.files.save"
  },
  {
    // Salvar TODOS os arquivos (antes de rodar testes/deploy)
    "key": "ctrl+alt+s",
    "command": "workbench.action.files.saveAll"
  },

  // ===================================================================
  //  2. MULTI-CURSOR E MANIPULAÇÃO DE LINHAS
  // ===================================================================
  {
    "key": "ctrl+d",
    "command": "editor.action.addSelectionToNextFindMatch",
    "when": "editorFocus"
  },
  {
    // Seleciona TODAS as ocorrências de uma vez
    "key": "ctrl+shift+l",
    "command": "editor.action.selectHighlights",
    "when": "editorFocus"
  },
  {
    "key": "ctrl+k ctrl+d",
    "command": "editor.action.moveSelectionToNextFindMatch",
    "when": "editorFocus"
  },
  {
    "key": "alt+click",
    "command": "editor.action.insertCursor"
  },
  {
    "key": "ctrl+alt+up",
    "command": "editor.action.insertCursorAbove",
    "when": "editorTextFocus"
  },
  {
    "key": "ctrl+alt+down",
    "command": "editor.action.insertCursorBelow",
    "when": "editorTextFocus"
  },
  {
    "key": "alt+up",
    "command": "editor.action.moveLinesUpAction",
    "when": "editorTextFocus && !editorReadonly"
  },
  {
    "key": "alt+down",
    "command": "editor.action.moveLinesDownAction",
    "when": "editorTextFocus && !editorReadonly"
  },
  {
    "key": "shift+alt+down",
    "command": "editor.action.copyLinesDownAction",
    "when": "editorTextFocus && !editorReadonly"
  },
  {
    "key": "shift+alt+up",
    "command": "editor.action.copyLinesUpAction",
    "when": "editorTextFocus && !editorReadonly"
  },
  {
    "key": "ctrl+shift+k",
    "command": "editor.action.deleteLines",
    "when": "editorTextFocus && !editorReadonly"
  },
  {
    "key": "ctrl+enter",
    "command": "editor.action.insertLineAfter",
    "when": "editorTextFocus && !editorReadonly"
  },
  {
    "key": "ctrl+shift+enter",
    "command": "editor.action.insertLineBefore",
    "when": "editorTextFocus && !editorReadonly"
  },
  {
    "key": "ctrl+j",
    "command": "editor.action.joinLines",
    "when": "editorTextFocus && !editorReadonly"
  },

  // ===================================================================
  //  3. NAVEGAÇÃO DE CÓDIGO
  // ===================================================================
  {
    "key": "f12",
    "command": "editor.action.revealDefinition",
    "when": "editorTextFocus"
  },
  {
    "key": "alt+f12",
    "command": "editor.action.peekDefinition",
    "when": "editorTextFocus"
  },
  {
    "key": "ctrl+f12",
    "command": "editor.action.goToImplementation",
    "when": "editorTextFocus"
  },
  {
    "key": "shift+f12",
    "command": "editor.action.goToReferences",
    "when": "editorTextFocus"
  },
  {
    "key": "ctrl+alt+left",
    "command": "workbench.action.navigateBack"
  },
  {
    "key": "ctrl+alt+right",
    "command": "workbench.action.navigateForward"
  },
  {
    "key": "ctrl+g",
    "command": "workbench.action.gotoLine"
  },
  {
    "key": "ctrl+shift+o",
    "command": "workbench.action.gotoSymbol"
  },
  {
    "key": "ctrl+t",
    "command": "workbench.action.showAllSymbols"
  },
  {
    "key": "ctrl+p",
    "command": "workbench.action.quickOpen"
  },
  {
    "key": "f8",
    "command": "editor.action.marker.next",
    "when": "editorFocus"
  },
  {
    "key": "shift+f8",
    "command": "editor.action.marker.prev",
    "when": "editorFocus"
  },

  // ===================================================================
  //  4. REFATORAÇÃO E QUICK FIX
  // ===================================================================
  {
    "key": "f2",
    "command": "editor.action.rename",
    "when": "editorTextFocus && !editorReadonly"
  },
  {
    // Quick Fix / Code Actions (rubocop, imports Java, etc)
    "key": "ctrl+.",
    "command": "editor.action.quickFix",
    "when": "editorTextFocus"
  },
  {
    "key": "ctrl+shift+r",
    "command": "editor.action.refactor",
    "when": "editorTextFocus && !editorReadonly"
  },
  {
    "key": "shift+alt+f",
    "command": "editor.action.formatDocument",
    "when": "editorTextFocus && !editorReadonly"
  },
  {
    "key": "ctrl+k ctrl+f",
    "command": "editor.action.formatSelection",
    "when": "editorTextFocus && !editorReadonly"
  },
  {
    // Organizar imports (Python isort / Java / JS)
    "key": "ctrl+shift+i",
    "command": "editor.action.organizeImports",
    "when": "editorTextFocus && !editorReadonly"
  },
  {
    "key": "ctrl+/",
    "command": "editor.action.commentLine",
    "when": "editorTextFocus && !editorReadonly"
  },
  {
    "key": "ctrl+shift+/",
    "command": "editor.action.blockComment",
    "when": "editorTextFocus && !editorReadonly"
  },
  {
    "key": "ctrl+space",
    "command": "editor.action.triggerSuggest",
    "when": "editorTextFocus"
  },
  {
    "key": "ctrl+k ctrl+i",
    "command": "editor.action.showHover",
    "when": "editorTextFocus"
  },

  // ===================================================================
  //  5. BUSCA E SUBSTITUIÇÃO
  // ===================================================================
  {
    "key": "ctrl+f",
    "command": "actions.find",
    "when": "editorFocus"
  },
  {
    "key": "ctrl+h",
    "command": "editor.action.startFindReplaceAction",
    "when": "editorFocus"
  },
  {
    "key": "ctrl+shift+f",
    "command": "workbench.action.findInFiles"
  },
  {
    "key": "ctrl+shift+h",
    "command": "workbench.action.replaceInFiles"
  },

  // ===================================================================
  //  6. DOBRAMENTO (models Rails / classes Java longas)
  // ===================================================================
  {
    "key": "ctrl+shift+[",
    "command": "editor.fold",
    "when": "editorTextFocus"
  },
  {
    "key": "ctrl+shift+]",
    "command": "editor.unfold",
    "when": "editorTextFocus"
  },
  {
    "key": "ctrl+k ctrl+0",
    "command": "editor.foldAll",
    "when": "editorTextFocus"
  },
  {
    "key": "ctrl+k ctrl+j",
    "command": "editor.unfoldAll",
    "when": "editorTextFocus"
  },

  // ===================================================================
  //  7. PAINÉIS, LAYOUT E ZOOM
  // ===================================================================
  {
    "key": "ctrl+shift+p",
    "command": "workbench.action.showCommands"
  },
  {
    "key": "ctrl+b",
    "command": "workbench.action.toggleSidebarVisibility"
  },
  {
    "key": "ctrl+shift+e",
    "command": "workbench.view.explorer"
  },
  {
    "key": "ctrl+shift+g",
    "command": "workbench.view.scm"
  },
  {
    "key": "ctrl+shift+d",
    "command": "workbench.view.debug"
  },
  {
    // View de extensões (nativo, não colide com o agente)
    "key": "ctrl+shift+x",
    "command": "workbench.view.extensions"
  },
  {
    "key": "ctrl+shift+m",
    "command": "workbench.actions.view.problems"
  },
  {
    "key": "ctrl+k z",
    "command": "workbench.action.toggleZenMode"
  },
  {
    "key": "ctrl+numpad_add",
    "command": "workbench.action.zoomIn"
  },
  {
    "key": "ctrl+=",
    "command": "workbench.action.zoomIn"
  },
  {
    "key": "ctrl+numpad_subtract",
    "command": "workbench.action.zoomOut"
  },
  {
    "key": "ctrl+-",
    "command": "workbench.action.zoomOut"
  },
  {
    "key": "ctrl+numpad0",
    "command": "workbench.action.zoomReset"
  },

  // ===================================================================
  //  8. SPLIT / GRUPOS DE EDITOR E ABAS
  // ===================================================================
  {
    "key": "ctrl+\\",
    "command": "workbench.action.splitEditor"
  },
  {
    "key": "ctrl+shift+\\",
    "command": "workbench.action.splitEditorDown"
  },
  {
    "key": "ctrl+1",
    "command": "workbench.action.focusFirstEditorGroup"
  },
  {
    "key": "ctrl+2",
    "command": "workbench.action.focusSecondEditorGroup"
  },
  {
    "key": "ctrl+3",
    "command": "workbench.action.focusThirdEditorGroup"
  },
  {
    "key": "ctrl+w",
    "command": "workbench.action.closeActiveEditor"
  },
  {
    // Reabrir aba fechada (salvador de vidas)
    "key": "ctrl+shift+t",
    "command": "workbench.action.reopenClosedEditor"
  },
  {
    "key": "ctrl+pagedown",
    "command": "workbench.action.nextEditor",
    "when": "!terminalFocus"
  },
  {
    "key": "ctrl+pageup",
    "command": "workbench.action.previousEditor",
    "when": "!terminalFocus"
  },

  // ===================================================================
  //  9. TERMINAL (ctrl+c aqui = SIGINT, mata processo)
  // ===================================================================
  {
    "key": "ctrl+`",
    "command": "workbench.action.terminal.toggleTerminal"
  },
  {
    "key": "ctrl+shift+`",
    "command": "workbench.action.terminal.new"
  },
  {
    // Matar processo travado (rails s, docker, node, pytest...)
    "key": "ctrl+c",
    "command": "workbench.action.terminal.sendSequence",
    "args": { "text": "\u0003" },
    "when": "terminalFocus"
  },
  {
    // Limpar terminal (no terminal; fora dele, o Ctrl+L nativo foca o chat)
    "key": "ctrl+l",
    "command": "workbench.action.terminal.clear",
    "when": "terminalFocus"
  },
  {
    "key": "ctrl+shift+w",
    "command": "workbench.action.terminal.kill",
    "when": "terminalFocus"
  },
  {
    // Split do terminal (rails server | rails console lado a lado)
    "key": "ctrl+shift+5",
    "command": "workbench.action.terminal.split",
    "when": "terminalFocus"
  },
  {
    "key": "ctrl+pagedown",
    "command": "workbench.action.terminal.focusNext",
    "when": "terminalFocus"
  },
  {
    "key": "ctrl+pageup",
    "command": "workbench.action.terminal.focusPrevious",
    "when": "terminalFocus"
  },

  // ===================================================================
  // 10. DEBUG (Python / Java / Ruby via debug adapters)
  // ===================================================================
  {
    "key": "f5",
    "command": "workbench.action.debug.start",
    "when": "!inDebugMode"
  },
  {
    "key": "f5",
    "command": "workbench.action.debug.continue",
    "when": "inDebugMode"
  },
  {
    "key": "shift+f5",
    "command": "workbench.action.debug.stop",
    "when": "inDebugMode"
  },
  {
    "key": "ctrl+shift+f5",
    "command": "workbench.action.debug.restart",
    "when": "inDebugMode"
  },
  {
    "key": "f10",
    "command": "workbench.action.debug.stepOver",
    "when": "inDebugMode"
  },
  {
    "key": "f11",
    "command": "workbench.action.debug.stepInto",
    "when": "inDebugMode"
  },
  {
    "key": "shift+f11",
    "command": "workbench.action.debug.stepOut",
    "when": "inDebugMode"
  },
  {
    "key": "f9",
    "command": "editor.debug.action.toggleBreakpoint",
    "when": "editorTextFocus"
  },
  {
    "key": "ctrl+f9",
    "command": "editor.debug.action.conditionalBreakpoint",
    "when": "editorTextFocus"
  },

  // ===================================================================
  // 11. TESTES (RSpec/Minitest, pytest, JUnit)
  //     IDs validados: testing.* nativos do editor
  // ===================================================================
  {
    "key": "ctrl+; a",
    "command": "testing.runAll"
  },
  {
    "key": "ctrl+; f",
    "command": "testing.runCurrentFile",
    "when": "editorTextFocus"
  },
  {
    "key": "ctrl+; c",
    "command": "testing.runAtCursor",
    "when": "editorTextFocus"
  },
  {
    "key": "ctrl+; d",
    "command": "testing.debugAtCursor",
    "when": "editorTextFocus"
  },
  {
    "key": "ctrl+; l",
    "command": "testing.reRunLastRun"
  },
  {
    "key": "ctrl+; t",
    "command": "workbench.view.testing.focus"
  },

  // ===================================================================
  // 12. GIT (GitLens, git-graph)
  // ===================================================================
  {
    "key": "ctrl+k ctrl+c",
    "command": "git.commitAll"
  },
  {
    "key": "ctrl+k ctrl+s",
    "command": "git.stage"
  },
  {
    "key": "ctrl+k ctrl+p",
    "command": "git.push"
  },
  {
    "key": "ctrl+k ctrl+u",
    "command": "git.pull"
  },
  {
    "key": "ctrl+k ctrl+g",
    "command": "git-graph.view"
  },
  {
    "key": "alt+pagedown",
    "command": "workbench.action.editor.nextChange",
    "when": "editorTextFocus"
  },
  {
    "key": "alt+pageup",
    "command": "workbench.action.editor.previousChange",
    "when": "editorTextFocus"
  },

  // ===================================================================
  // 13. FRONTEND (Emmet, HTML/ERB, Tailwind)
  // ===================================================================
  {
    "key": "ctrl+alt+w",
    "command": "editor.emmet.action.wrapWithAbbreviation",
    "when": "editorTextFocus && !editorReadonly"
  },
  {
    "key": "ctrl+alt+m",
    "command": "editor.emmet.action.matchTag",
    "when": "editorTextFocus"
  },
  {
    // Selecionar a tag pai (balance outward) - ótimo em ERB/HTML
    "key": "ctrl+alt+b",
    "command": "editor.emmet.action.balanceOut",
    "when": "editorTextFocus"
  },

  // ===================================================================
  // 14. RUBY / RAILS (ruby-lsp)  [IDs validados: rubyLsp.*]
  // ===================================================================
  {
    // Reiniciar o Ruby LSP quando engasgar
    "key": "ctrl+k r r",
    "command": "rubyLsp.restart"
  },
  {
    // Rodar teste na linha do cursor via ruby-lsp
    "key": "ctrl+k r t",
    "command": "rubyLsp.runTest",
    "when": "editorLangId == 'ruby'"
  },
  {
    // Rodar teste no terminal
    "key": "ctrl+k r shift+t",
    "command": "rubyLsp.runTestInTerminal",
    "when": "editorLangId == 'ruby'"
  },
  {
    // rails generate
    "key": "ctrl+k r g",
    "command": "rubyLsp.railsGenerate"
  },
  {
    // Ir para arquivo relevante (source <-> spec)
    "key": "ctrl+k r f",
    "command": "rubyLsp.goToRelevantFile",
    "when": "editorLangId == 'ruby'"
  },

  // ===================================================================
  // 15. PYTHON  [IDs validados: python.*]
  // ===================================================================
  {
    "key": "ctrl+k p i",
    "command": "python.setInterpreter"
  },
  {
    "key": "ctrl+k p f",
    "command": "python.execInTerminal",
    "when": "editorLangId == 'python'"
  },
  {
    "key": "ctrl+k p s",
    "command": "python.execSelectionInTerminal",
    "when": "editorLangId == 'python'"
  },
  {
    // Abrir REPL nativo do Python
    "key": "ctrl+k p r",
    "command": "python.startNativeREPL"
  },

  // ===================================================================
  // 16. JAVA  [IDs validados: java.*]
  // ===================================================================
  {
    // Rebuild do workspace Java
    "key": "ctrl+k j b",
    "command": "java.project.build.workspace"
  },
  {
    // Limpar workspace do Java LS e reiniciar
    "key": "ctrl+k j c",
    "command": "java.clean.workspace"
  },
  {
    // Reiniciar o Java Language Server
    "key": "ctrl+k j r",
    "command": "java.server.restart"
  },

  // ===================================================================
  // 17. DOCKER  [ID validado: containersView]
  // ===================================================================
  {
    "key": "ctrl+k d d",
    "command": "workbench.view.extension.containersView"
  }

  // ===================================================================
  // NOTA: os atalhos do AGENTE do Antigravity já vêm nativos e NÃO
  // precisam ser declarados aqui:
  //   Ctrl+L               -> foca o chat do agente (fora do terminal)
  //   Ctrl+Alt+B           -> abre o painel do agente
  //   Ctrl+Shift+A         -> seletor de conversas
  //   Ctrl+Shift+L         -> nova conversa
  //   Ctrl+E               -> alterna workspace <-> agente
  //   Ctrl+I               -> inline chat / edição assistida
  // Por isso deixei Ctrl+Shift+A e Ctrl+Shift+L livres nesta config.
  // ===================================================================

]
